

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
}

enum IsActive {
    ACTIVE
    INACTIVE
}

enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
}

model User {
  id       String @id @default(uuid(7)) @unique
  name     String @unique
  username  String @unique
  email     String @unique
  password  String
  image     String?
  role      Role @default(USER)
  isActive  IsActive @default(ACTIVE)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
  orders    Order[]
  @@map("users")
}

model Review {
  id        String   @id @default(uuid(7))
  rating    Int      @default(5)
  comment   String?
  userId    String
  productId String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@map("reviews")
}

model Product {
  id          String   @id @default(uuid(7))
  name        String
  title       String
  image       String
  description String?
  price       Float
  stock       Int      @default(0)
  categoryId  String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reviews  Review[]
  @@index([categoryId])
  @@map("products")
}

model Category {
  id        String   @id @default(uuid(7))
  name      String   @unique
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product[]

  @@map("categories")
}

model Order {
  id            String      @id @default(uuid(7))
  userId        String
  totalAmount   Float
  status        OrderStatus @default(PENDING)
  items         Json
  paymentIntentId String?
  isDeleted     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("orders")
}
